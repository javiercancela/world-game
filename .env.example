# Export these variables in your shell; .env is not loaded automatically.
WORLD_GAME_PROVIDER=local
# Server root or /v1 API URL; supports local OpenAI-compatible Chat Completions.
WORLD_GAME_BASE_URL=http://127.0.0.1:8080/v1
# Use the ID/alias advertised by GET /v1/models, not the mmproj vision projector.
WORLD_GAME_MODEL=/home/xavi/bonsai/models/bonsai2-gguf/27B/Ternary-Bonsai-2-27B-PQ2_0.gguf
# Optional authentication for the configured local server (never uses OPENAI_API_KEY).
WORLD_GAME_API_KEY=
# Bonsai reasoning is disabled for bounded structured calls. Empty uses server defaults.
WORLD_GAME_REASONING_EFFORT=none
WORLD_GAME_MAX_OUTPUT_TOKENS=1800
# For cloud play, set WORLD_GAME_PROVIDER=openai, WORLD_GAME_MODEL, and OPENAI_API_KEY.
# OPENAI_API_KEY=
# WORLD_GAME_SAVE_DIR=/path/to/campaigns
WORLD_GAME_TIMEOUT=30
WORLD_GAME_CALL_BUDGET=8
WORLD_GAME_PROVIDER_DEADLINE=120
WORLD_GAME_CONTEXT_TOKENS=8000
